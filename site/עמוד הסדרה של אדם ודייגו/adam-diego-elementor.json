=root.querySelectorAll('.reveal:not([data-rv])');\n    if(!('IntersectionObserver' in window)){els.forEach(function(el){el.classList.add('in');el.setAttribute('data-rv','1');});return;}\n    var io=new IntersectionObserver(function(ents,obs){ents.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');obs.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -8% 0px'});\n    els.forEach(function(el){el.setAttribute('data-rv','1');io.observe(el);});\n  }\n  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}\n})();\n</script>"
