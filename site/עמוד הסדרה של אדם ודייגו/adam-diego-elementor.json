            {
              "id": "7f4226e",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "\n<link href=\"https://fonts.googleapis.com/css2?family=Suez+One&family=Rubik:wght@300;400;500;600;700;800&family=Gveret+Levin+AlefAlefAlef&display=swap\" rel=\"stylesheet\">\n<style>\n  .adam-lp{--accent:#c4673f;--page:#f4ecdd;--band:#ece1cb;--card:#fbf7ee;--tilt:1.9;--decor:1;background:var(--page);font-family:Rubik,system-ui,sans-serif;color:#2e2419;line-height:normal}\n  .adam-lp *{box-sizing:border-box}\n  .adam-lp .wrap{max-width:1080px;margin:0 auto;padding:0 26px}\n  .adam-lp details>summary{list-style:none;cursor:pointer}\n  .adam-lp details>summary::-webkit-details-marker{display:none}\n  .adam-lp details[open] .faqplus{transform:rotate(45deg)}\n  .adam-lp .twocol{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}\n  .adam-lp .books{display:grid;grid-template-columns:1fr 1fr;gap:24px}\n  .adam-lp .trust{display:flex}\n  .adam-lp .pros{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\n  .adam-lp .feats{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}\n  @media(max-width:760px){\n    .adam-lp .twocol{grid-template-columns:1fr;gap:24px}\n    .adam-lp .books{grid-template-columns:1fr}\n    .adam-lp .trust{flex-wrap:wrap}\n    .adam-lp .pros{grid-template-columns:1fr}\n    .adam-lp .feats{grid-template-columns:1fr 1fr;gap:28px 18px}\n    .adam-lp .hidem{display:none !important}\n    .adam-lp .showm{display:inline !important}\n    .adam-lp .h1{font-size:30px !important}\n  }\n  @media (prefers-reduced-motion: no-preference){\n    .adam-lp .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.2,.7,.3,1),transform .7s cubic-bezier(.2,.7,.3,1)}\n    .adam-lp .reveal.in{opacity:1;transform:none}\n  }\n  .adam-lp .lift{transition:transform .35s cubic-bezier(.2,.7,.3,1),box-shadow .35s cubic-bezier(.2,.7,.3,1)}\n  .adam-lp .lift:hover{transform:translateY(-8px) rotate(0deg);box-shadow:0 22px 48px rgba(46,36,25,.22)}\n  .adam-lp .cover-lift{transition:transform .4s cubic-bezier(.2,.7,.3,1),box-shadow .4s cubic-bezier(.2,.7,.3,1)}\n  .adam-lp .cover-lift:hover{transform:rotate(0deg) translateY(-6px) scale(1.03);box-shadow:0 26px 52px rgba(46,36,25,.34)}\n  .adam-lp .pop{transition:transform .25s cubic-bezier(.2,.7,.3,1),box-shadow .25s cubic-bezier(.2,.7,.3,1)}\n  .adam-lp .pop:hover{transform:translateY(-3px) scale(1.04)}\n  .adam-lp .pop:active{transform:translateY(-1px) scale(.99)}\n  .adam-lp .arrow-link{display:inline-block}\n  .adam-lp .arrow-link span.arw{display:inline-block;transition:transform .25s cubic-bezier(.2,.7,.3,1)}\n  .adam-lp .arrow-link:hover span.arw{transform:translateX(-5px)}\n  .adam-lp .soft-edge{border-style:solid;border-color:transparent;border-width:0;border-image:linear-gradient(to right, transparent 4%, rgba(120,96,52,.32) 28%, rgba(120,96,52,.32) 72%, transparent 96%) 1}\n  .adam-lp .soft-edge.t{border-top-width:2px}\n  .adam-lp .soft-edge.tb{border-top-width:2px;border-bottom-width:2px}\n  .adam-lp .blob{position:absolute;border-radius:50%;filter:blur(38px);opacity:calc(var(--decor,.6) * .5);pointer-events:none;z-index:0}\n  .adam-lp .ink{color:#2e2419;opacity:calc(var(--decor,.6) * .5)}\n  .adam-lp .trail{display:flex;align-items:center;justify-content:center;gap:0;opacity:var(--decor,.6);margin:0 auto}\n  .adam-lp .underline-word{position:relative;white-space:nowrap}\n  .adam-lp .underline-word svg{position:absolute;left:-4%;bottom:-.32em;width:108%;height:.38em;overflow:visible;opacity:var(--decor,.6)}\n  .adam-lp .underline-word svg path{stroke:var(--accent,#c4673f);stroke-width:5;fill:none;stroke-linecap:round;stroke-dasharray:260;stroke-dashoffset:260;transition:stroke-dashoffset 1.1s cubic-bezier(.2,.7,.3,1) .2s}\n  .adam-lp .underline-word.in svg path{stroke-dashoffset:0}\n  @media (prefers-reduced-motion: reduce){ .adam-lp .underline-word svg path{transition:none;stroke-dashoffset:0} }\n</style>\n<div class=\"adam-lp\" dir=\"rtl\">\n\n  <!-- ===== HEADER ===== -->\n  <div class=\"soft-edge\" style=\"position:sticky;top:0;z-index:50;background:rgba(244,236,221,.92);backdrop-filter:blur(8px);border-bottom-width:2px\">\n    <div class=\"wrap\" style=\"display:flex;align-items:center;gap:18px;height:66px\">\n      <a href=\"https://www.roeeliss.co.il\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;flex-direction:column;gap:1px;text-decoration:none\">\n        <div style=\"font-family:'Suez One',serif;font-size:19px;color:#2e2419\">רועי ליס</div>\n        <div style=\"font:500 10px Rubik;color:#9a8c73;letter-spacing:.05em\">פסיכולוג חינוכי מומחה</div>\n        <div style=\"font:500 10px Rubik;color:#9a8c73;letter-spacing:.05em\">מומחה בטיפול קוגניטיבי התנהגותי</div>\n      </a>\n      <div class=\"hidem\" style=\"flex:1;display:flex;gap:26px;justify-content:center;color:#6b5d49;font:500 14px Rubik\">\n        <a href=\"#about-series\" style=\"color:inherit;text-decoration:none\">אדם ודייגו בארץ הרגשות</a>\n        <a href=\"#reviews\" style=\"color:inherit;text-decoration:none\">המלצות</a>\n        <a href=\"#books\" style=\"color:inherit;text-decoration:none\">הספרים שלנו</a>\n        <a href=\"#pros\" style=\"color:inherit;text-decoration:none\">למטפלים</a>\n        <a href=\"#about\" style=\"color:inherit;text-decoration:none\">רועי ודייגו</a>\n        <a href=\"#faq\" style=\"color:inherit;text-decoration:none\">שאלות נפוצות</a>\n      </div>\n      <div style=\"margin-right:auto;display:flex;align-items:center;gap:14px\">\n        <a href=\"#bundle\" class=\"pop\" style=\"background:var(--accent,#c4673f);color:#fff;border-radius:9px;font:600 14px Rubik;padding:10px 18px;text-decoration:none;box-shadow:0 3px 10px rgba(196,103,63,.28)\"><span class=\"hidem\">שתי הרפתקאות, מחיר מיוחד · 89₪</span><span class=\"showm\" style=\"display:none\">לרכישה</span></a>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== HERO ===== -->\n  <div class=\"wrap\" style=\"position:relative;padding-top:54px;padding-bottom:54px\">\n    <div class=\"twocol\" style=\"position:relative;z-index:1\">\n      <div style=\"display:flex;flex-direction:column;gap:18px\">\n        <div style=\"font-family:'Suez One',serif;font-size:18px;color:var(--accent,#c4673f);letter-spacing:.01em\">אדם ודייגו בארץ הרגשות</div>\n        <h1 class=\"h1\" style=\"font-family:'Suez One',serif;font-size:42px;line-height:1.16;color:#2e2419;margin:0\">כלים רגשיים בסיפורים<br>שילדים <span class=\"underline-word reveal\">אוהבים<svg viewBox=\"0 0 200 20\" preserveAspectRatio=\"none\"><path d=\"M5 13 C 38 4, 76 17, 116 9 S 176 6, 195 12\"></path></svg></span></h1>\n        <div style=\"font:400 17px/1.65 Rubik;color:#5b4e3b;max-width:470px;text-wrap:pretty\">סיפורי הרפתקה שילדים אוהבים, עם כלים מעולם ה־CBT להתמודדות עם פחדים וחרדות, כעסים וקשיי ויסות רגשי.</div>\n        <div style=\"display:inline-flex;align-items:center;gap:10px;background:var(--card,#fbf7ee);border:1px solid #e7dcc7;border-radius:30px;padding:8px 16px;align-self:flex-start;box-shadow:0 3px 10px rgba(46,36,25,.07)\">\n          <span style=\"font:600 14px Rubik;color:#2e2419\">למעלה מ-8,000 עותקים בבתים ובקליניקות בישראל</span>\n        </div>\n        <div style=\"display:flex;flex-direction:column;gap:13px;align-items:flex-start;margin-top:4px\">\n          <a href=\"#bundle\" class=\"pop\" style=\"background:var(--accent,#c4673f);color:#fff;border-radius:11px;font:600 16px Rubik;padding:15px 32px;text-decoration:none;box-shadow:0 5px 16px rgba(196,103,63,.3)\">שתי הרפתקאות, מחיר מיוחד · 89₪ ←</a>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:14px;margin-top:6px;font:500 13px Rubik;color:#8a7c66\">\n          <span>★ מומלץ ע״י הורים, מטפלים ואנשי מקצוע</span><span style=\"width:4px;height:4px;border-radius:50%;background:#c4a87f\"></span><span>משלוח 1–5 ימי עסקים</span>\n        </div>\n      </div>\n      <div style=\"position:relative;display:flex;align-items:center;justify-content:center;gap:0;min-height:420px\">\n        <div class=\"cover-lift\" style=\"border-radius:9px;overflow:hidden;box-shadow:0 18px 40px rgba(46,36,25,.3);transform:rotate(calc(var(--tilt,1) * -5deg));width:236px;height:330px;position:relative;z-index:1;margin-left:-26px\">\n          <img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/יער המחשבות המפחידות - כריכה עבור מיכל דליות.png\" alt=\"יער המחשבות המפחידות\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n        </div>\n        <div class=\"cover-lift\" style=\"border-radius:9px;overflow:hidden;box-shadow:0 18px 40px rgba(46,36,25,.32);transform:rotate(calc(var(--tilt,1) * 5deg));width:248px;height:346px;position:relative;z-index:2;margin-right:-26px\">\n          <img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/הר כעס כריכה.jpg\" alt=\"הר כעס\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== TRUST BAR ===== -->\n  <div class=\"soft-edge tb\" style=\"background:var(--band,#ece1cb)\">\n    <div class=\"wrap\" style=\"padding:34px 26px\">\n      <div class=\"feats\" style=\"gap:20px\">\n        <div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;gap:9px\">\n          <div style=\"width:34px;height:3px;border-radius:3px;background:var(--accent,#c4673f)\"></div>\n          <div style=\"font:700 16px Rubik;color:#2e2419\">מבוסס CBT</div>\n          <div style=\"font:400 13px/1.55 Rubik;color:#6b5d49;max-width:200px\">הספרים נכתבו לפי הפרוטוקול העדכני של טיפול CBT בילדים</div>\n        </div>\n        <div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;gap:9px\">\n          <div style=\"width:34px;height:3px;border-radius:3px;background:var(--accent,#c4673f)\"></div>\n          <div style=\"font:700 16px Rubik;color:#2e2419\">כלים מעשיים</div>\n          <div style=\"font:400 13px/1.55 Rubik;color:#6b5d49;max-width:200px\">כלים שמטפלים משתמשים בהם, בגרסה ידידותית לילדים</div>\n        </div>\n        <div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;gap:9px\">\n          <div style=\"width:34px;height:3px;border-radius:3px;background:var(--accent,#c4673f)\"></div>\n          <div style=\"font:700 16px Rubik;color:#2e2419\">ספר לשניים</div>\n          <div style=\"font:400 13px/1.55 Rubik;color:#6b5d49;max-width:200px\">קוראים יחד ויוצרים שיחה משמעותית בצורה טבעית</div>\n        </div>\n        <div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;gap:9px\">\n          <div style=\"width:34px;height:3px;border-radius:3px;background:var(--accent,#c4673f)\"></div>\n          <div style=\"font:700 16px Rubik;color:#2e2419\">דפי הנחיה וצביעה</div>\n          <div style=\"font:400 13px/1.55 Rubik;color:#6b5d49;max-width:200px\">לכל ספר דפי הנחיה להורים ולמטפלים ודפי צביעה לילדים</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== EMPATHY / FROM CLINIC ===== -->\n  <div id=\"about-series\" class=\"wrap\" style=\"padding:64px 26px\">\n    <div class=\"twocol\">\n      <div style=\"border-radius:20px;overflow:hidden;box-shadow:0 14px 36px rgba(46,36,25,.2);border:5px solid var(--card,#fbf7ee);transform:rotate(calc(var(--tilt,1) * -1deg))\">\n        <img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/8 - new.png\" alt=\"אדם ודייגו מתחבקים\" style=\"width:100%;height:360px;object-fit:cover;object-position:center 38%;display:block\">\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:16px\">\n        <div style=\"font:600 13px Rubik;color:#b07a4a;letter-spacing:.06em\">מהקליניקה אליכם</div>\n        <h2 style=\"font-family:'Suez One',serif;font-size:30px;line-height:1.25;color:#2e2419;margin:0\">הידע שעובד בקליניקה —<br>עכשיו בסיפורים שילדים אוהבים</h2>\n        <div style=\"font:400 16px/1.7 Rubik;color:#5b4e3b\">סדרת ״אדם ודייגו בארץ הרגשות״ נולדה מתוך שנים של עבודה טיפולית עם ילדים והורים. כפסיכולוג, ראיתי שוב ושוב שכשילדים מקבלים כלים בשפה שמתאימה להם — הם מצליחים להבין את עצמם טוב יותר ולהתמודד בצורה בריאה יותר.</div>\n        <div style=\"font:400 16px/1.7 Rubik;color:#5b4e3b\">זו הייתה ההשראה שלי — להביא לכל בית את הקסם של דייגו יחד עם ידע מקצועי מהקליניקה, ולהפוך אותם לסיפורים שילדים אוהבים לקרוא, ורוכשים מהם כלים לחיים.</div>\n        <div style=\"font:600 15px Rubik;color:#2e2419;margin-top:4px\">רועי ליס · פסיכולוג חינוכי מומחה, מומחה ב־CBT</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== TESTIMONIALS ===== -->\n  <div id=\"reviews\" class=\"soft-edge tb\" style=\"position:relative;overflow:hidden;background:var(--band,#ece1cb)\">\n    <div class=\"blob\" style=\"width:340px;height:340px;background:var(--accent,#c4673f);top:-90px;right:-70px\"></div>\n    <div class=\"blob\" style=\"width:300px;height:300px;background:#5b7c8c;bottom:-110px;left:-60px\"></div>\n    <div class=\"wrap\" style=\"position:relative;z-index:1;padding:64px 26px\">\n      <div style=\"text-align:center;margin-bottom:34px\">\n        <h2 style=\"font-family:'Suez One',serif;font-size:32px;color:#2e2419;margin:6px 0 0\">הורים ומטפלים מספרים על ״אדם ודייגו״</h2>\n      </div>\n      <!-- featured -->\n      <div class=\"reveal\" style=\"background:var(--card,#fbf7ee);border-radius:18px;padding:30px 34px;box-shadow:0 8px 26px rgba(46,36,25,.1);max-width:760px;margin:0 auto 22px\">\n        <div style=\"font-family:'Suez One',serif;font-size:54px;color:#e0c8a0;line-height:.6;height:24px\">״</div>\n        <div style=\"font:400 18px/1.7 Rubik;color:#43382a\">בני תבור בן שבע וחצי עבר לישון איתנו… היו לו חרדות להיות לבד, מרעשים חזקים, ואפילו בשינה היה צועק ורועד. לפני מספר ימים רכשתי את הספר… לאחר שעברנו על ההדרכה שוחחנו והקראנו את הסיפור, תבור אמר ״אני חושב שאני מוכן לחזור למיטה שלי״. אחרי חמישה חודשים תבור הצליח לישון לבד. המון תודה!״</div>\n        <div style=\"display:flex;align-items:center;gap:11px;margin-top:18px\">\n          <div style=\"width:40px;height:40px;border-radius:50%;background:var(--accent,#c4673f);color:#fff;display:flex;align-items:center;justify-content:center;font:700 16px Rubik\">ש</div>\n          <div><div style=\"font:600 14px Rubik;color:#2e2419\">שולמית</div><div style=\"font:500 12px Rubik;color:#8a7c66\">אמא של תבור</div></div>\n        </div>\n      </div>\n      <!-- pro row -->\n      <div class=\"pros\" style=\"max-width:1160px;margin:0 auto;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))\">\n        <div class=\"lift reveal\" style=\"background:var(--card,#fbf7ee);border-radius:14px;padding:20px;box-shadow:0 4px 16px rgba(46,36,25,.07)\">\n          <div style=\"font:400 14px/1.6 Rubik;color:#5b4e3b\">״גיליתי ספר ילדים חשוב מאין כמותו״</div>\n          <div style=\"border-top:1px solid #ece2cd;margin-top:14px;padding-top:12px;font:600 13px Rubik;color:#2e2419\">מיכל דליות<div style=\"font:500 12px Rubik;color:#8a7c66;margin-top:2px\">אמא</div></div>\n        </div>\n        <div class=\"lift reveal\" style=\"background:var(--card,#fbf7ee);border-radius:14px;padding:20px;box-shadow:0 4px 16px rgba(46,36,25,.07)\">\n          <div style=\"font:400 14px/1.6 Rubik;color:#5b4e3b\">״ספר מקסים שעוסק בצורה חכמה ורגישה בהבדל בין רגשות טבעיים של פחד לבין מצבים שמתעוררת בהם חרדה… מומלץ מאוד לילדים, להורים ולאנשי מקצוע.״</div>\n          <div style=\"border-top:1px solid #ece2cd;margin-top:14px;padding-top:12px;font:600 13px Rubik;color:#2e2419\">פרופ׳ תומר שכנר<div style=\"font:500 12px Rubik;color:#8a7c66;margin-top:2px\">בית הספר למדעי הפסיכולוגיה, אוניברסיטת חיפה</div></div>\n        </div>\n        <div class=\"lift reveal\" style=\"background:var(--card,#fbf7ee);border-radius:14px;padding:20px;box-shadow:0 4px 16px rgba(46,36,25,.07)\">\n          <div style=\"font:400 14px/1.6 Rubik;color:#5b4e3b\">״כאמא לילדה בת שמונה וכמורה לחינוך מיוחד, הספר מהווה כלי מקסים לשיח עם הילדים על חרדות ודאגות… מומלץ בחום בכל בית ולכל מורה ומחנך!״</div>\n          <div style=\"border-top:1px solid #ece2cd;margin-top:14px;padding-top:12px;font:600 13px Rubik;color:#2e2419\">ורד הזרחי<div style=\"font:500 12px Rubik;color:#8a7c66;margin-top:2px\">MA בלקויות למידה, מורה לחינוך מיוחד</div></div>\n        </div>\n        <div class=\"lift reveal\" style=\"background:var(--card,#fbf7ee);border-radius:14px;padding:20px;box-shadow:0 4px 16px rgba(46,36,25,.07)\">\n          <div style=\"font:400 14px/1.6 Rubik;color:#5b4e3b\">״אדם ודייגו: הר כעס\" ספר פשוט נפלא! ממחיש כל כך בצניעות ובברור את הנושא בתוך סיפור מקסים של קשר בטוח בין אדם לדייגו. הספר מתאים לילדים להורים ולמטפלים ממליצה ממש 🙏</div>\n          <div style=\"border-top:1px solid #ece2cd;margin-top:14px;padding-top:12px;font:600 13px Rubik;color:#2e2419\">אפרת אדמון</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== TWO BOOKS ===== -->\n  <div id=\"books\" class=\"wrap\" style=\"padding:66px 26px\">\n    <div style=\"text-align:center;margin-bottom:38px\">\n      <h2 style=\"font-family:'Suez One',serif;font-size:32px;color:#2e2419;margin:6px 0 0\">ספרי \"אדם ודייגו בארץ הרגשות\"</h2>\n    </div>\n    <div class=\"books\">\n      <!-- book 1 -->\n      <div class=\"lift reveal\" style=\"background:var(--card,#fbf7ee);border-radius:18px;overflow:hidden;box-shadow:0 8px 26px rgba(46,36,25,.1);display:flex;flex-direction:column\">\n        <div style=\"height:330px;position:relative;background:linear-gradient(160deg,#e2ebdb,#eef1ea);display:flex;align-items:flex-end;justify-content:center;padding-top:26px\">\n          <img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/יער המחשבות המפחידות - כריכה עבור מיכל דליות.png\" alt=\"יער המחשבות המפחידות\" style=\"height:300px;width:auto;display:block;border-radius:6px 6px 0 0;box-shadow:0 12px 28px rgba(46,36,25,.28)\">\n          <div style=\"position:absolute;top:14px;right:14px;background:#4f6b43;color:#fff;border-radius:20px;font:600 12px Rubik;padding:5px 13px\">פחדים וחרדות</div>\n        </div>\n        <div style=\"padding:22px 24px;display:flex;flex-direction:column;gap:11px;flex:1\">\n          <h3 style=\"font-family:'Suez One',serif;font-size:23px;color:#2e2419;margin:0\">אדם ודייגו ביער המחשבות המפחידות</h3>\n          <div style=\"font:400 14px/1.6 Rubik;color:#5b4e3b;flex:1\">כשאדם מוצף בפחדים, הוא ודייגו יוצאים להרפתקה ביער מכושף — ואדם לומד כלים להתגבר על מה שנראה מפחיד מאוד.</div>\n          <div style=\"display:flex;align-items:center;gap:12px;margin-top:6px\">\n            <div style=\"font-family:'Suez One',serif;font-size:24px;color:#2e2419\">49₪</div>\n            <a href=\"#\" style=\"flex:1;text-align:center;border:1.8px solid #2e2419;color:#2e2419;border-radius:10px;font:600 14px Rubik;padding:11px;text-decoration:none\">הוספה לעגלה</a>\n          </div>\n          <a href=\"https://roeeliss.co.il/product/adam-and-diego-in-the-forest-of-scary-thoughts/\" target=\"_blank\" rel=\"noopener\" class=\"pop\" style=\"text-align:center;background:#eef1ea;color:#4f6b43;border:1.5px solid #cdd9c4;border-radius:10px;font:700 14px Rubik;padding:12px;text-decoration:none\">👁 בואו לגלות את יער המחשבות ←</a>\n        </div>\n      </div>\n      <!-- book 2 -->\n      <div class=\"lift reveal\" style=\"background:var(--card,#fbf7ee);border-radius:18px;overflow:hidden;box-shadow:0 8px 26px rgba(46,36,25,.1);display:flex;flex-direction:column\">\n        <div style=\"height:330px;position:relative;background:linear-gradient(160deg,#f1d9cf,#fbeae2);display:flex;align-items:flex-end;justify-content:center;padding-top:26px\">\n          <img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/הר כעס כריכה.jpg\" alt=\"הר כעס\" style=\"height:300px;width:auto;display:block;border-radius:6px 6px 0 0;box-shadow:0 12px 28px rgba(46,36,25,.28)\">\n          <div style=\"position:absolute;top:14px;right:14px;background:#bb4a2c;color:#fff;border-radius:20px;font:600 12px Rubik;padding:5px 13px\">כעס וקשיי ויסות</div>\n        </div>\n        <div style=\"padding:22px 24px;display:flex;flex-direction:column;gap:11px;flex:1\">\n          <h3 style=\"font-family:'Suez One',serif;font-size:23px;color:#2e2419;margin:0\">אדם ודייגו: הר כעס</h3>\n          <div style=\"font:400 14px/1.6 Rubik;color:#5b4e3b;flex:1\">כשאדם מתפרץ בכעס בלי שליטה, הוא ודייגו יוצאים להרפתקה בהר הכעס — ואדם לומד כלים חשובים לעצירה ולוויסות רגשי.</div>\n          <div style=\"display:flex;align-items:center;gap:12px;margin-top:6px\">\n            <div style=\"font-family:'Suez One',serif;font-size:24px;color:#2e2419\">49₪</div>\n            <a href=\"#\" style=\"flex:1;text-align:center;border:1.8px solid #2e2419;color:#2e2419;border-radius:10px;font:600 14px Rubik;padding:11px;text-decoration:none\">הוספה לעגלה</a>\n          </div>\n          <a href=\"https://roeeliss.co.il/product/adam-and-diego-volcanger/\" target=\"_blank\" rel=\"noopener\" class=\"pop\" style=\"text-align:center;background:#f7e7e0;color:#bb4a2c;border:1.5px solid #ecccbf;border-radius:10px;font:700 14px Rubik;padding:12px;text-decoration:none\">👁 בואו איתנו להר הכעס ←</a>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== BUNDLE ===== -->\n  <div id=\"bundle\" class=\"wrap\" style=\"padding:10px 26px 70px\">\n    <div style=\"position:relative;overflow:hidden;border-radius:22px;background:#2e2419;box-shadow:0 18px 44px rgba(46,36,25,.28)\">\n      <img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/פורזץ מעודכן.jpeg\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.16;display:block\">\n      <div style=\"position:absolute;inset:0;background:linear-gradient(90deg,rgba(46,36,25,.96) 30%,rgba(46,36,25,.6) 100%)\"></div>\n      <div class=\"twocol\" style=\"position:relative;padding:42px 44px;gap:34px\">\n        <div style=\"display:flex;flex-direction:column;gap:14px\">\n          <div style=\"font:600 13px Rubik;color:#e0b9a6;letter-spacing:.06em\">⭐ הבחירה הפופולרית של הורים</div>\n          <h2 style=\"font-family:'Suez One',serif;font-size:30px;line-height:1.25;color:#fdf6ea;margin:0\">החבילה המלאה — שני ספרים, שפה רגשית אחת</h2>\n          <div style=\"font:400 16px/1.65 Rubik;color:#d8cbb6\">התמודדות עם פחדים וכעסים, באותה שפה משותפת. מענה רחב לעולם הרגשי של הילד — ובמחיר משתלם יותר.</div>\n          <div style=\"display:flex;align-items:center;gap:16px;margin-top:8px;flex-wrap:wrap\">\n            <div style=\"font-family:'Suez One',serif;font-size:38px;color:#fff\">89₪</div>\n            <div style=\"font:500 17px Rubik;color:#9a8c73;text-decoration:line-through\">98₪</div>\n            <a href=\"#\" class=\"pop\" style=\"background:var(--accent,#c4673f);color:#fff;border-radius:11px;font:600 16px Rubik;padding:15px 32px;text-decoration:none;box-shadow:0 6px 18px rgba(196,103,63,.4)\">שתי הרפתקאות, מחיר מיוחד ←</a>\n          </div>\n          <div style=\"font:500 13px Rubik;color:#b7a98f;margin-top:2px\">כולל קישור לדפי הנחיות להורים ומטפלים ודפי צביעה לילדים</div>\n        </div>\n        <div class=\"hidem\" style=\"display:flex;align-items:center;justify-content:center;gap:18px\">\n          <div class=\"cover-lift\" style=\"border-radius:8px;overflow:hidden;box-shadow:0 16px 34px rgba(0,0,0,.5);transform:rotate(calc(var(--tilt,1) * -4deg));width:160px;height:222px\"><img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/יער המחשבות המפחידות - כריכה עבור מיכל דליות.png\" style=\"width:100%;height:100%;object-fit:cover\" alt=\"יער המחשבות המפחידות\"></div>\n          <div class=\"cover-lift\" style=\"border-radius:8px;overflow:hidden;box-shadow:0 16px 34px rgba(0,0,0,.5);transform:rotate(calc(var(--tilt,1) * 4deg));width:160px;height:222px\"><img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/הר כעס כריכה.jpg\" style=\"width:100%;height:100%;object-fit:cover\" alt=\"הר כעס\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== THERAPISTS ===== -->\n  <div id=\"pros\" class=\"soft-edge tb\" style=\"position:relative;overflow:hidden;background:var(--band,#ece1cb)\">\n    <div class=\"blob\" style=\"width:320px;height:320px;background:#4f6b43;bottom:-100px;right:-60px\"></div>\n    <div class=\"wrap twocol\" style=\"position:relative;z-index:1;padding:56px 26px\">\n      <div style=\"display:flex;flex-direction:column;gap:14px\">\n        <div style=\"font:600 13px Rubik;color:#b07a4a;letter-spacing:.06em\">למטפלים ואנשי חינוך</div>\n        <h2 style=\"font-family:'Suez One',serif;font-size:27px;line-height:1.3;color:#2e2419;margin:0\">כלים לעבודה רגשית — בגובה העיניים</h2>\n        <div style=\"font:400 15px/1.7 Rubik;color:#5b4e3b\">הסדרה נכתבה בהשראת עקרונות העבודה הקליניים של CBT עם ילדים, ומשמשת פסיכולוגים, מטפלים, יועצות ואנשי חינוך ככלי לשיחה, כחומר בין פגישות וככלי לעבודה כיתתית.</div>\n        <div style=\"font:400 15px/1.7 Rubik;color:#5b4e3b\">לכל ספר מצורף קישור לדפי הנחיות מקצועיות ודפי צביעה ועבודה לילדים, שמעשירים ומדייקים את המפגשים.</div>\n        \n      </div>\n      <div class=\"reveal\" style=\"border-radius:18px;overflow:hidden;box-shadow:0 12px 30px rgba(46,36,25,.18);border:5px solid var(--card,#fbf7ee)\">\n        <img src=\"https://REPLACE-WITH-YOUR-SITE/wp-content/uploads/14 - new.png\" alt=\"\" style=\"width:100%;height:280px;object-fit:cover;object-position:center 28%;display:block\">\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== ABOUT ===== -->\n  <div id=\"about\" class=\"wrap twocol\" style=\"padding:64px 26px\">\n    <div style=\"border-radius:18px;overflow:hidden;background:#e9e0cf;border:5px solid var(--card,#fbf7ee);box-shadow:0 12px 30px rgba(46,36,25,.16)\">\n      <img src=\"https://roeeliss.co.il/wp-content/uploads/2023/07/roi-and-diego-768x576.webp\" alt=\"רועי ודייגו\" style=\"width:100%;height:340px;object-fit:cover;object-position:center 30%;display:block\">\n    </div>\n    <div style=\"display:flex;flex-direction:column;gap:14px\">\n      \n      <h2 style=\"font-family:'Suez One',serif;font-size:28px;line-height:1.3;color:#2e2419;margin:0\">היי, אנחנו שמחים שהצטרפתם להרפתקה שלנו</h2>\n      <div style=\"font:400 16px/1.7 Rubik;color:#5b4e3b\">אני רועי, וזה דייגו — הכלב שלי, השותף שלי לדרך. דייגו מצטרף אליי לטיפולים מאז שהיה בן שלושה חודשים, ובכל יום מחדש אני מתרגש מהקסם שהוא מביא איתו, ולומד ממנו דברים חדשים.</div>\n      <div style=\"font:400 16px/1.7 Rubik;color:#5b4e3b\">לאורך השנים, כפסיכולוג חינוכי מומחה ומומחה ב־CBT, זכיתי לפגוש מאות ילדים. גיליתי שכשמלמדים ילדים את הכלים הנכונים, הם מצליחים להתמודד ולעבור תהליכים משמעותיים.</div>\n      <div style=\"font:400 16px/1.7 Rubik;color:#5b4e3b\">החלום שלי, כשהתחלתי לכתוב את סדרת ספרי ״אדם ודייגו״, היה להנגיש את הידע המקצועי שלי יחד עם החום והתבונה של דייגו — לכל ילד וילדה שצריכים אותם.</div>\n    </div>\n  </div>\n\n  <!-- ===== FAQ ===== -->\n  <div id=\"faq\" class=\"soft-edge t\" style=\"background:var(--band,#ece1cb)\">\n    <div class=\"wrap\" style=\"padding:60px 26px;max-width:820px\">\n      <h2 style=\"font-family:'Suez One',serif;font-size:30px;color:#2e2419;margin:0 0 26px;text-align:center\">שאלות נפוצות</h2>\n      <div style=\"display:flex;flex-direction:column;gap:12px\">\n        <details style=\"background:var(--card,#fbf7ee);border-radius:13px;padding:4px 20px;box-shadow:0 3px 12px rgba(46,36,25,.06)\">\n          <summary style=\"display:flex;justify-content:space-between;align-items:center;padding:16px 0;font:600 16px Rubik;color:#2e2419\">לאילו גילים הספרים מתאימים?<span class=\"faqplus\" style=\"font-size:22px;color:var(--accent,#c4673f);transition:transform .2s\">+</span></summary>\n          <div style=\"font:400 15px/1.7 Rubik;color:#5b4e3b;padding:0 0 18px\">הספרים נכתבו לילדים מגיל 6 ומעלה. בכל עמוד ספר באתר אפשר לקרוא את העמודים הראשונים ולהתרשם אם הסגנון ורמת הקריאה מתאימים לילד שלכם.</div>\n        </details>\n        <details style=\"background:var(--card,#fbf7ee);border-radius:13px;padding:4px 20px;box-shadow:0 3px 12px rgba(46,36,25,.06)\">\n          <summary style=\"display:flex;justify-content:space-between;align-items:center;padding:16px 0;font:600 16px Rubik;color:#2e2419\">תוך כמה זמן הספרים יגיעו אליי?<span class=\"faqplus\" style=\"font-size:22px;color:var(--accent,#c4673f);transition:transform .2s\">+</span></summary>\n          <div style=\"font:400 15px/1.7 Rubik;color:#5b4e3b;padding:0 0 18px\">המשלוחים יוצאים במהירות ומגיעים לכל רחבי הארץ תוך 1–5 ימי עסקים, לנקודת איסוף או עם שליח עד הבית.</div>\n        </details>\n        <details style=\"background:var(--card,#fbf7ee);border-radius:13px;padding:4px 20px;box-shadow:0 3px 12px rgba(46,36,25,.06)\">\n          <summary style=\"display:flex;justify-content:space-between;align-items:center;padding:16px 0;font:600 16px Rubik;color:#2e2419\">אפשר לקנות רק ספר אחד?<span class=\"faqplus\" style=\"font-size:22px;color:var(--accent,#c4673f);transition:transform .2s\">+</span></summary>\n          <div style=\"font:400 15px/1.7 Rubik;color:#5b4e3b;padding:0 0 18px\">בהחלט. אפשר לרכוש כל ספר בנפרד. עם זאת, הרבה הורים בוחרים בחבילה המלאה, כי שני הספרים יחד נותנים מענה רחב יותר — גם פחדים וגם כעסים, בשפה אחת.</div>\n        </details>\n        <details style=\"background:var(--card,#fbf7ee);border-radius:13px;padding:4px 20px;box-shadow:0 3px 12px rgba(46,36,25,.06)\">\n          <summary style=\"display:flex;justify-content:space-between;align-items:center;padding:16px 0;font:600 16px Rubik;color:#2e2419\">מה ההבדל בין שני הספרים?<span class=\"faqplus\" style=\"font-size:22px;color:var(--accent,#c4673f);transition:transform .2s\">+</span></summary>\n          <div style=\"font:400 15px/1.7 Rubik;color:#5b4e3b;padding:0 0 18px\">״יער המחשבות המפחידות״ עוסק בפחדים, דאגות ומחשבות שמציפות ילדים. ״הר כעס״ עוסק בכעסים, קשיי ויסות והתפרצויות. שניהם באותה שפה רגשית ומקצועית.</div>\n        </details>\n        <details style=\"background:var(--card,#fbf7ee);border-radius:13px;padding:4px 20px;box-shadow:0 3px 12px rgba(46,36,25,.06)\">\n          <summary style=\"display:flex;justify-content:space-between;align-items:center;padding:16px 0;font:600 16px Rubik;color:#2e2419\">האם ניתן לשלם בביט?<span class=\"faqplus\" style=\"font-size:22px;color:var(--accent,#c4673f);transition:transform .2s\">+</span></summary>\n          <div style=\"font:400 15px/1.7 Rubik;color:#5b4e3b;padding:0 0 18px\">כן, בוודאי. בעמוד התשלום תוכלו לבחור האם לשלם באמצעות כרטיס אשראי או באמצעות ביט.</div>\n        </details>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== FINAL CTA ===== -->\n  <div class=\"wrap\" style=\"padding:70px 26px 30px;text-align:center\">\n    <h2 style=\"font-family:'Suez One',serif;font-size:34px;line-height:1.25;color:#2e2419;margin:0 0 10px\">תנו לילד את הכלים שהוא צריך — בשפה שהוא אוהב</h2>\n    <div style=\"font:400 17px Rubik;color:#5b4e3b;margin-bottom:26px\">החבילה המלאה של ״אדם ודייגו״ · משלוח מהיר עד הבית</div>\n    <div style=\"display:flex;gap:13px;justify-content:center;flex-wrap:wrap\">\n      <a href=\"#bundle\" class=\"pop\" style=\"background:var(--accent,#c4673f);color:#fff;border-radius:12px;font:600 17px Rubik;padding:16px 38px;text-decoration:none;box-shadow:0 6px 18px rgba(196,103,63,.32)\">שתי הרפתקאות, מחיר מיוחד · 89₪</a>\n      <a href=\"#books\" style=\"border:1.8px solid #2e2419;color:#2e2419;border-radius:12px;font:600 17px Rubik;padding:15px 32px;text-decoration:none\">לכל הספרים</a>\n    </div>\n  </div>\n\n  <!-- ===== FOOTER ===== -->\n  <div style=\"background:#2e2419;color:#cabda6\">\n    <div class=\"wrap\" style=\"padding:44px 26px 32px;display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap\">\n      <div style=\"min-width:180px\">\n        \n        <div style=\"font-family:'Suez One',serif;font-size:20px;color:#fdf6ea\">רועי ליס</div>\n        <div style=\"font:500 12px/1.7 Rubik;color:#9a8c73;margin-top:4px\">פסיכולוג חינוכי מומחה,<br>מומחה בטיפול CBT לילדים ונוער</div>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:8px;font:500 14px Rubik;color:#e4dac4;min-width:180px\">\n        <div>שפרינצק 3, תל אביב</div>\n        <a href=\"tel:0549107047\" style=\"color:inherit;text-decoration:none\">054-910-7047</a>\n      